//ACTIVES
ALIGN 4
ActivePlayer:
CHECK_ALLEGIANCE 0xFFFF
BEQ 0x0 0xC 0x2
CALL ActiveTrue
LABEL 0x0
ENDA

ALIGN 4
ActiveTrue:
CHECK_EVENTID
SADD 0xC2
ENUF_SLOT2
EVBIT_T 0x7
ENDB

//REINFORCEMENTS
//Reinforcements:

//MISC
NoEvents:
END_MAIN

Tutorial:
END_MAIN

//camera
MapPreviewEvt:
CALL 0x8592140 // Ensure we aren't faded to black
ASMC ASMC_CameraNW
STAL 15
ASMC ASMC_CameraSW
STAL 15
ASMC ASMC_CameraSE
STAL 15
ASMC ASMC_CameraNE
STAL 15
ASMC ASMC_CameraLord 
EVBIT_T 7
ENDA