#include EAstdlib.event

EventPointerTable(0xa,ThisChapter)

ORG StartOffset
ThisChapter:
POIN TurnBasedEventsP3
POIN CharacterBasedEventsP3
POIN LocationBasedEventsP3
POIN MiscBasedEventsP3
POIN Dunno Dunno Dunno
POIN TutorialP3
POIN TrapDataP3 TrapDataP3
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningSceneP3 EndingSceneP3

TurnBasedEventsP3:
END_MAIN
ALIGN 32 //For some reason, CharacterBasedEventsP3 have to be 32-Aligned?

CharacterBasedEventsP3:
END_MAIN

LocationBasedEventsP3:
END_MAIN

MiscBasedEventsP3:
CauseGameOverIfLordDies
END_MAIN

Dunno:
END_MAIN

TutorialP3:
END_MAIN

TrapDataP3:
ENDTRAP

ALIGN 4

Units:
UNIT

BeginningSceneP3:
ENDA

EndingSceneP3:
MoveToChapter(NextChapter)
ENDA

MESSAGE Events end at offset CURRENTOFFSET