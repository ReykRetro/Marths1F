#include EAstdlib.event

EventPointerTable(0x14,Pro4events)

setText(0x163, NewChNameP4)
ALIGN 4
NewChNameP4:
String("Prologue IV")
BYTE 0

ALIGN 4
Pro4events:
POIN TurnBasedEventsP4
POIN CharacterBasedEventsP4
POIN LocationBasedEventsP4
POIN MiscBasedEventsP4
POIN DunnoP41 DunnoP42 DunnoP43
POIN TutorialP4
POIN TrapDataP4 TrapDataP4
POIN UnitsP4 UnitsP4
POIN $0 $0 $0 $0 $0 $0
POIN BeginningSceneP4 EndingSceneP4

TurnBasedEventsP4:
END_MAIN
ALIGN 32 //For some reason, CharacterBasedEventsP4 have to be 32-Aligned?

CharacterBasedEventsP4:
END_MAIN

LocationBasedEventsP4:
END_MAIN

MiscBasedEventsP4:
CauseGameOverIfLordDies
END_MAIN

DunnoP41:
END_MAIN
DunnoP42:
END_MAIN
DunnoP43:
END_MAIN

TutorialP4:
END_MAIN

TrapDataP4:
ENDTRAP

ALIGN 4

UnitsP4:
UNIT

BeginningSceneP4:
ENDA

EndingSceneP4:
MNC2 0x4
ENDA

MESSAGE Events end at offset CURRENTOFFSET