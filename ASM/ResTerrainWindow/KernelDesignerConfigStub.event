// ============================================
// Stub de configuracion para gpKernelDesignerConfig
// ============================================
// El ResTerrainWindow de Jester (compilado desde C contra el
// kernel de Mokha) lee gpKernelDesignerConfig->res_terrain_window
// para decidir si dibuja la ventana de terreno con 3 filas
// (Def/Res/Avo) o con las 2 de vanilla (Def/Avo).
//
// No instalamos el kernel completo de Mokha -- esto es solo una
// estructura "de mentiras" del tamanio minimo necesario, con un
// unico byte en 1 (offset 0x9F = res_terrain_window) y todo lo
// demas en 0. Offset calculado y verificado campo por campo contra
// include/kernel/kernel-lib.h (struct KernelDesigerConfig), 157
// campos antes de res_terrain_window, incluyendo el relleno de
// alineacion que mete el compilador antes de los dos u16
// (real_time_enemy_interval_frames, real_time_refresh_frames).
//
// IMPORTANTE: este archivo debe incluirse ANTES de
// ResTerrainWindow_Installer.event en tu buildfile, para que el
// simbolo gpKernelDesignerConfig ya exista cuando el .lyn.event
// lo referencie.
// ============================================

ALIGN 4
KernelDesignerConfig_Stub:
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
BYTE 0x01   // offset 0x9F: res_terrain_window = true (activa Def/Res/Avo)

ALIGN 4
gpKernelDesignerConfig:
POIN KernelDesignerConfig_Stub
