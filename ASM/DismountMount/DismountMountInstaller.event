// Dismount/Mount Installer (modificado para SkillSystem buildfile)
// Basado en Crazycolorz5 + addon de terreno de Contro

// Text IDs (asegurate de que estén definidos en tu text buildfile)

// Tabla de clases montadas/desmontadas
#define MountedUnmounted(classIDMounted, classIDUnmounted) "BYTE classIDMounted classIDUnmounted"
#define EndMountUnmountedTable "BYTE 0x00 0x00"

  MountedClassTable:
    // EDITÁ ESTO con tus clases reales
    MountedUnmounted(0x6, 0x1)   // Ejemplos — reemplazalos
    MountedUnmounted(0x5, 0x2)
    MountedUnmounted(0x29, 0x27)
    MountedUnmounted(0x2a, 0x28)
    MountedUnmounted(0x48, 0x4e)
    EndMountUnmountedTable
    
  ALIGN 4
  DismountRoutine:
  #incbin "ASM/DismountRoutine.dmp"
  POIN ClassTable
  POIN MountedClassTable
  
  DismountUsability:
  #incbin "ASM/DismountUsabilityRoutine.dmp"
  ORG CurrentOffset - 8
  POIN MountedClassTable
  POIN TerrainCheck
  
  MountRoutine:
  #incbin "ASM/MountRoutine.dmp"
  POIN ClassTable
  POIN MountedClassTable
  
  MountUsability:
  #incbin "ASM/MountUsabilityRoutine.dmp"
  ORG CurrentOffset - 8
  POIN MountedClassTable
  POIN TerrainCheck
  
  TerrainCheck:
  #incbin "ASM/TerrainCheck.dmp"
  ORG CurrentOffset - 4
  POIN ClassTable