//Copy from here 
PUSH 

//Standing MS
SetSMS(0x00, 1, Lord1stand)
SetSMS(0x01, 1, Lord2stand)
SetSMS(0x6b, 1, CavalierFstand)
SetSMS(0x6c, 1, PaladinFstand)
SetSMS(0x6d, 0, ShamanFstand)
SetSMS(0x6e, 0, DruidFstand)
SetSMS(0x6f, 1, SummonerFstand)
SetSMS(0x30, 0, ManaketeStand)
SetSMS(0x35, 1, BerserkerStand)
SetSMS(0x40, 1, DarkDruidstand)
SetSMS(0x67, 0, FireStand)
SetSMS(0x68, 0, ShineStand)


//Walking MS
SetMMS(0x00, Lord1walk, NormalAP)
SetMMS(0x01, Lord2walk, NormalAP)
SetMMS(0x05, CavalierFwalk, NormalAP)
SetMMS(0x07, PaladinFwalk, NormalAP)
SetMMS(0x2d, ShamanFwalk, NormalAP)
SetMMS(0x2f, DruidFwalk, NormalAP)
SetMMS(0x31, SummonerFwalk, NormalAP)
SetMMS(0x3b, ManaketeWalk, NormalAP)
SetMMS(0x42, BerserkerWalk, NormalAP)
SetMMS(0x4e, DarkDruidwalk, NormalAP)


POP
