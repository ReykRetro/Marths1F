EventPointerTable(0x7d, StrongholdAnims)
#ifndef tilesetAnimation
    #define tilesetAnimation(speed, size, pointer)    "BYTE speed 0; SHORT size; POIN pointer"
#endif

ALIGN 4
StrongholdAnims0:
#incext png2dmp "StrongholdAnims/StrAnims_000.png"
ALIGN 4
StrongholdAnims1:
#incext png2dmp "StrongholdAnims/StrAnims_001.png"
ALIGN 4
StrongholdAnims2:
#incext png2dmp "StrongholdAnims/StrAnims_002.png"
ALIGN 4
StrongholdAnims3:
