ALIGN 4
CastleObject:
#incext Png2Dmp --lz77 "CastleObject.png"

ALIGN 4
CastleTiles:
#incext compress "CastleTiles.mapchip_config"

ALIGN 4
CastlePalette1:
#incbin "CastlePalette1.dmp"
ALIGN 4
CastlePalette2:
