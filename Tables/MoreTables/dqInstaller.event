ALIGN 4
MarthsDeath:
CHECK_MODE
SVAL 1 0x0
BEQ 0x0 0xC 0x1
	Text(0xfd8)
	GOTO 1
LABEL 0
	Text(0xfd9)
LABEL 1
CHECK_ALIVE 0x9
SVAL 1 0x0
BEQ 2 0xC 0x0
CHECK_DEPLOYED 0x9
SVAL 1 0x0
BEQ 2 0xC 0x0
Text(0xfda)
	GOTO 99
LABEL 2
	CHECK_ALIVE 0x4
	SVAL 1 0x0
	BEQ 3 0xC 0x0
	CHECK_DEPLOYED 0x4
	SVAL 1 0x0
	BEQ 3 0xC 0x0
	Text(0xfdb)
		GOTO 99
	LABEL 3
		CHECK_EVENTID 0xb1
		SVAL 1 0x0
		BEQ 4 0xC 0x0
		Text(0xfdc)
			GOTO 99
		LABEL 4
			CHECK_EVENTID 0xb2
			SVAL 1 0x0
			BNE 99 0xC 0x0
			Text(0xfdd)
LABEL 99
ENUT GameOverFlag
NoFade
ENDA

gordinsDeath:
CHECK_CHAPTER_NUMBER
SVAL 1 0x3
BEQ 0 0xC 0x0
	CHECK_ALLEGIANCE 0x6
	SVAL 1 0x1
	BEQ 0 0xC 0x0
	Text(0x931)
	GOTO 99
LABEL 0
	Text(0x932)
LABEL 99
NoFade
ENDA
